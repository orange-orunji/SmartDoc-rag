# ── Python 缓存 ──
__pycache__/
*.py[cod]
.venv/

# ── IDE / 系统 ──
.idea/
.cursor/
.vscode/
.DS_Store
Thumbs.db

# ── 敏感配置（通过 env_file 注入，不打包进镜像）──
.env

# ── 本地数据库与运行时数据（通过 volume 挂载）──
app.db
app.db-shm
app.db-wal
app/data/
data/

# ── 版本控制 ──
.git/
.gitignore

# ── 文档（不需要进镜像）──
docs/
*.md
!requirements.txt

# ── 评测脚本 ──
app/eval_retrieval.py
app/eval_questions.json
